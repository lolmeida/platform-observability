<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.lolmeida.platform</groupId>
  <artifactId>platform-observability</artifactId>
  <version>0.1.3</version>
  <packaging>pom</packaging>
  <name>Platform Observability</name>
  <description>Versioned observability contract and Quarkus adapter for PEAH services</description>
  <modules><module>observability-contract</module><module>observability-quarkus</module></modules>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.20.3</quarkus.platform.version>
    <junit.version>5.11.4</junit.version>
    <spotless.version>2.43.0</spotless.version>
  </properties>
  <dependencyManagement><dependencies>
    <dependency><groupId>${quarkus.platform.group-id}</groupId><artifactId>${quarkus.platform.artifact-id}</artifactId><version>${quarkus.platform.version}</version><type>pom</type><scope>import</scope></dependency>
  </dependencies></dependencyManagement>
  <build><pluginManagement><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><release>${maven.compiler.release}</release></configuration></plugin>
    <plugin><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><argLine>-Djava.util.logging.manager=org.jboss.logmanager.LogManager</argLine></configuration></plugin>
    <plugin><groupId>com.diffplug.spotless</groupId><artifactId>spotless-maven-plugin</artifactId><version>${spotless.version}</version><configuration><java><googleJavaFormat><version>1.24.0</version></googleJavaFormat><removeUnusedImports/><formatAnnotations/></java></configuration></plugin>
  </plugins></pluginManagement><plugins>
    <plugin><groupId>com.diffplug.spotless</groupId><artifactId>spotless-maven-plugin</artifactId></plugin>
  </plugins></build>
</project>
